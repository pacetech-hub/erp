# PostgreSQL (Azure Database for PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pace_seller?schema=public"

# Segredo JWT do projeto Supabase (Project Settings > API > JWT Secret),
# usado para validar os access tokens emitidos pelo Supabase Auth.
SUPABASE_JWT_SECRET="changeme"

# Origens permitidas para CORS (separadas por vírgula). Deixe em branco para liberar todas em dev.
CORS_ORIGIN=""

PORT=3000
